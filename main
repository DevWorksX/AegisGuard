--[[
    AegisGuard v3 — Account & Inventory Protector
    Runtime patcher for the Roblox client.
    
    Blocks malicious scripts disguised as "cheats" from touching your
    inventory, Robux, tokens, files, and privacy.
    
    Run BEFORE any third-party scripts. Recommended: autoexec.
    License: MIT
]]

local ORIG = {
    loadstring      = loadstring,
    getfenv         = getfenv,
    getgenv         = getgenv,
    request         = (typeof(request) == "function") and request or nil,
    http_request    = (typeof(http_request) == "function") and http_request or nil,
    http_request_m  = (typeof(http) == "table" and typeof(http.request) == "function") and http.request or nil,
    fluxus_request  = (typeof(fluxus) == "table" and typeof(fluxus.request) == "function") and fluxus.request or nil,
    newcclosure     = (typeof(newcclosure) == "function") and newcclosure or nil,
    hookmetamethod  = (typeof(hookmetamethod) == "function") and hookmetamethod or nil,
    getnamecall     = (typeof(getnamecallmethod) == "function") and getnamecallmethod or nil,
    checkcaller     = (typeof(checkcaller) == "function") and checkcaller or nil,
    debug_getinfo   = (typeof(debug) == "table" and typeof(debug.getinfo) == "function") and debug.getinfo or nil,
    task_wait       = task.wait,
    task_spawn      = task.spawn,
    task_delay      = task.delay,
}

-- // Тихая функция логирования. Выводит только в консоль разработчика (F9)
local function log_block(reason)
    warn("[AegisGuard] Blocked: " .. tostring(reason))
end

local MALICIOUS_URLS = {
    "https://raw.githubusercontent.com/sekrte3345544/Roblox/main/new-obfuscated.lua",
    "https://raw.githubusercontent.com/FilteringEnabled/FE/main/asd",
    "https://pastebin.com/raw/u78XNnGV",
}

local function isMaliciousUrl(url)
    if type(url) ~= "string" then return false end
    for _, bad in ipairs(MALICIOUS_URLS) do
        if url == bad then return true end
    end
    return false
end

local MALICIOUS_BODIES = {}
for _, url in ipairs(MALICIOUS_URLS) do
    local ok, body = pcall(game.HttpGet, game, url)
    if ok and type(body) == "string" and #body > 0 then
        MALICIOUS_BODIES[#MALICIOUS_BODIES + 1] = body
    end
end

local function isMaliciousBody(code)
    if type(code) ~= "string" then return false end
    for _, bad in ipairs(MALICIOUS_BODIES) do
        if code == bad then return true end
    end
    return false
end

local loadstringCount = 0
local function safeLoadstring(code, chunkname)
    if isMaliciousBody(code) then
        log_block("malicious script to load")
        return function() end
    end
    
    loadstringCount = loadstringCount + 1
    if loadstringCount > 8 then
        log_block("Rate limit: too many loadstring calls")
        return function() end
    end
    
    ORIG.task_delay(1, function()
        loadstringCount = math.max(0, loadstringCount - 1)
    end)
    return ORIG.loadstring(code, chunkname or "")
end
ORIG.getgenv().loadstring = safeLoadstring

local FILE_IO_BLACKLIST = {
    readfile = "", writefile = nil, appendfile = nil,
    delfile = nil, delfolder = nil, listfiles = {},
    makefolder = nil, isfile = false, isfolder = false,
    loadfile = nil, dofile = nil,
}

for name, returnValue in pairs(FILE_IO_BLACKLIST) do
    if ORIG.getgenv()[name] then
        local captured = name
        local ret = returnValue
        ORIG.getgenv()[name] = function(...)
            log_block("file I/O operation: " .. captured)
            return ret
        end
    end
end

local rbxapis  = game:GetService("HttpRbxApiService")
local omni     = game:GetService("OmniRecommendationsService")

local oldIndex
oldIndex = ORIG.hookmetamethod(game, "__index", ORIG.newcclosure(function(self, key)
    if key == "MessageBusService" and self == game then
        log_block("access to MessageBusService")
        return nil
    end
    return oldIndex(self, key)
end))

local oldNamecall
oldNamecall = ORIG.hookmetamethod(game, "__namecall", ORIG.newcclosure(function(self, ...)
    if ORIG.checkcaller() then
        local method = ORIG.getnamecall()
        local args = { ... }
        local errstr = "[AegisGuard] Blocked " .. tostring(method)

        if self == game and method == "GetService" and args[1] == "MessageBusService" then
            log_block("access to MessageBusService")
            error(errstr)
        end

        if typeof(self) == "Instance" and self.ClassName == "MessageBusService" then
            local allowed = { GetFullName = true, ClassName = true }
            if not allowed[method] then
                log_block("MessageBusService method: " .. tostring(method))
                error(errstr)
            end
        end

        local BLOCKED = {
            PerformPurchaseV2 = true, OpenNativeOverlay = true,
            AddCoreScriptLocal = true, EmitHybridEvent = true,
            SendCommand = true, ReturnToJavaScript = true,
            PromptRobloxPurchase = true, PromptThirdPartyPurchase = true,
            PostAsyncFullUrl = true, GetAsyncFullUrl = true,
            RequestAsync = true, PostAsync = true,
            HttpRequestAsync = true, ReportAbuseV3 = true,
        }
        if BLOCKED[method] then
            log_block("malicious function: " .. tostring(method))
            return nil
        end

        if (method == "GetAsync" and self == rbxapis) or (method == "MakeRequest" and self == omni) then
            log_block("malicious function: " .. tostring(method))
            return nil
        end

        if method == "TakeScreenshot" or method == "ToggleRecording" or method == "GetRobuxBalance" then
            log_block("malicious function: " .. tostring(method))
            error(errstr)
        end
        if self == game and method == "Load" then
            log_block("game:Load")
            error(errstr)
        end
    end
    return oldNamecall(self, ...)
end))

local DANGEROUS_INTROSPECTION = {
    "getgc", "getreg", "getupvalue", "setupvalue",
    "getconstants", "setconstant", "getprotos",
    "getstack", "setstack", "getinfo",
}
for _, name in ipairs(DANGEROUS_INTROSPECTION) do
    if ORIG.getgenv()[name] then
        local captured = name
        ORIG.getgenv()[name] = function()
            log_block("dangerous introspection: " .. captured)
            return nil
        end
    end
end

if ORIG.newcclosure then
    local wrappedLS = ORIG.newcclosure(function(...) return safeLoadstring(...) end)
    ORIG.getgenv().loadstring = wrappedLS
end

local function wrapRequest(originalFn, t)
    if type(t) ~= "table" or type(t.Url) ~= "string" then
        return originalFn(t)
    end
    if t.Url:match("^https://") and t.Url:match("roblox%.com") and not t.Url:match("games%.roblox%.com") then
        return {
            Success = true, StatusCode = 200, StatusMessage = "OK",
            Headers = {}, Cookies = {}, Body = '{"status":"OK"}',
        }
    end
    if isMaliciousUrl(t.Url) then
        return {
            Success = true, StatusCode = 200, StatusMessage = "OK",
            Headers = {}, Cookies = {}, Body = '{"status":"OK"}',
        }
    end
    return originalFn(t)
end

if ORIG.request then
    ORIG.getgenv().request = function(t) return wrapRequest(ORIG.request, t) end
end
if ORIG.http_request then
    ORIG.getgenv().http_request = function(t) return wrapRequest(ORIG.http_request, t) end
end
if ORIG.http_request_m then
    ORIG.getgenv().http.request = function(t) return wrapRequest(ORIG.http_request_m, t) end
end
if ORIG.fluxus_request then
    ORIG.getgenv().fluxus.request = function(t) return wrapRequest(ORIG.fluxus_request, t) end
end
